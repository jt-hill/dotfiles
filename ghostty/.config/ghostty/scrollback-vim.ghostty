# Vim-style scrollback navigation via key tables (Ghostty 1.3+).
# Adapted from mitchellh's config in ghostty-org/ghostty#3708.
# Ghostty intercepts these keys itself, so it works inside TUIs like Claude Code.

# Entry point (kitty's show_scrollback key)
keybind = ctrl+shift+h=activate_key_table:vim

keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1
keybind = vim/ctrl+e=scroll_page_lines:1
keybind = vim/ctrl+y=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_fractional:0.5
keybind = vim/ctrl+u=scroll_page_fractional:-0.5
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next
keybind = vim/shift+n=navigate_search:previous

# Copy the current (mouse) selection
keybind = vim/y=copy_to_clipboard

# Exit
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Swallow everything else so stray keys don't reach the app underneath
keybind = vim/catch_all=ignore
